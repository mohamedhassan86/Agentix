{
  "name": "agentix",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "worker": "tsx --env-file=.env.local src/worker/main.ts",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:performance": "vitest run tests/integration/performance",
    "test:policy": "node scripts/check-tests.mjs",
    "architecture:check": "node scripts/check-architecture.mjs",
    "openapi:generate": "tsx scripts/generate-openapi.ts",
    "openapi:check": "node scripts/check-openapi.mjs",
    "license:check": "node scripts/check-licenses.mjs",
    "prisma:validate": "prisma validate",
    "db:migrate": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "config:check": "tsx scripts/check-config.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.5.0",
    "@auth/prisma-adapter": "^2.7.4",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.80.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.202.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.202.0",
    "@opentelemetry/resources": "^2.1.0",
    "@opentelemetry/sdk-metrics": "^2.1.0",
    "@opentelemetry/sdk-node": "^0.202.0",
    "@opentelemetry/sdk-trace-node": "^2.1.0",
    "@opentelemetry/semantic-conventions": "^1.36.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "argon2": "^0.45.0",
    "dotenv": "^17.4.2",
    "lucide-react": "^0.511.0",
    "next": "^16.3.5",
    "next-auth": "^5.0.0-beta.25",
    "pg": "^8.13.0",
    "pino": "^10.3.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "uuid": "^14.0.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@testcontainers/postgresql": "^12.1.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/uuid": "^11.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^9.18.0",
    "eslint-config-next": "^16.3.5",
    "globals": "^17.12.0",
    "jsdom": "^26.0.0",
    "license-checker-rseidelsohn": "^5.0.1",
    "prisma": "^7.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  }
}
