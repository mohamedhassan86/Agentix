{
  "openapi": "3.1.0",
  "info": {
    "title": "Agentix Foundation API",
    "version": "0.1.0",
    "description": "Foundation-only contract for health, versioned ping, and non-business demonstration work."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "tags": [
    {
      "name": "Health",
      "description": "Process liveness and dependency readiness."
    },
    {
      "name": "Foundation",
      "description": "Versioned ping and non-business foundation validation operations."
    }
  ],
  "components": {
    "headers": {
      "XCorrelationId": {
        "name": "X-Correlation-Id",
        "description": "Canonical request correlation UUID",
        "schema": {
          "def": {
            "type": "string",
            "checks": [
              {
                "def": {
                  "type": "string",
                  "format": "uuid",
                  "check": "string_format",
                  "abort": false,
                  "pattern": {}
                },
                "type": "string"
              }
            ]
          },
          "type": "string"
        }
      },
      "NoStore": {
        "name": "Cache-Control",
        "description": "Health/status output is not cached",
        "schema": {
          "def": {
            "type": "literal",
            "values": [
              "no-store"
            ]
          },
          "type": "literal",
          "values": {}
        }
      }
    },
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "alive",
              "ready"
            ]
          },
          "service": {
            "type": "string",
            "enum": [
              "agentix-web"
            ]
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50
          },
          "time": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "status",
          "service",
          "version",
          "time"
        ]
      },
      "PingResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          },
          "service": {
            "type": "string",
            "enum": [
              "agentix"
            ]
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50
          },
          "time": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "status",
          "service",
          "version",
          "time"
        ]
      },
      "FoundationWorkStatus": {
        "type": "string",
        "enum": [
          "queued",
          "processing",
          "succeeded",
          "failed"
        ]
      },
      "FoundationWorkResponse": {
        "type": "object",
        "properties": {
          "requestId": {
            "type": "string",
            "format": "uuid"
          },
          "workId": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "$ref": "#/components/schemas/FoundationWorkStatus"
          },
          "attemptCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10
          },
          "effectCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1
          },
          "requestedAt": {
            "type": "string",
            "format": "date-time"
          },
          "completedAt": {
            "type": "string",
            "nullable": true,
            "format": "date-time"
          },
          "lastErrorCode": {
            "type": "string",
            "nullable": true,
            "minLength": 1,
            "maxLength": 120
          }
        },
        "required": [
          "requestId",
          "workId",
          "status",
          "attemptCount",
          "effectCount",
          "requestedAt"
        ]
      },
      "Problem": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "number",
            "minimum": 400,
            "maximum": 599
          },
          "code": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{1,119}$"
          },
          "correlationId": {
            "type": "string",
            "format": "uuid"
          },
          "detail": {
            "type": "string"
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "instance": {
            "type": "string"
          },
          "dependency": {
            "type": "string",
            "enum": [
              "database",
              "schema"
            ]
          },
          "reason": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{2,63}$"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code",
          "correlationId"
        ]
      },
      "ReadinessProblem": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Problem"
          },
          {
            "type": "object",
            "properties": {},
            "required": [
              "dependency"
            ]
          }
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/health/live": {
      "get": {
        "tags": [
          "Health"
        ],
        "operationId": "getLiveness",
        "summary": "Check web-process liveness",
        "responses": {
          "200": {
            "description": "Process can answer requests",
            "headers": {
              "X-Correlation-Id": {
                "$ref": "#/components/headers/XCorrelationId"
              },
              "Cache-Control": {
                "$ref": "#/components/headers/NoStore"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "403": {
            "description": "Origin not allowed",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "tags": [
          "Health"
        ],
        "operationId": "getReadiness",
        "summary": "Check required dependency readiness",
        "responses": {
          "200": {
            "description": "Required database and schema are ready",
            "headers": {
              "X-Correlation-Id": {
                "$ref": "#/components/headers/XCorrelationId"
              },
              "Cache-Control": {
                "$ref": "#/components/headers/NoStore"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "403": {
            "description": "Origin not allowed",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "A required dependency category is unavailable",
            "headers": {
              "X-Correlation-Id": {
                "$ref": "#/components/headers/XCorrelationId"
              },
              "Cache-Control": {
                "$ref": "#/components/headers/NoStore"
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessProblem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/ping": {
      "get": {
        "tags": [
          "Foundation"
        ],
        "operationId": "getPing",
        "summary": "Exercise versioned query dispatch",
        "responses": {
          "200": {
            "description": "Foundation is responsive",
            "headers": {
              "X-Correlation-Id": {
                "$ref": "#/components/headers/XCorrelationId"
              },
              "Cache-Control": {
                "$ref": "#/components/headers/NoStore"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PingResponse"
                }
              }
            }
          },
          "403": {
            "description": "Origin not allowed",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/foundation/work": {
      "post": {
        "tags": [
          "Foundation"
        ],
        "operationId": "createFoundationWork",
        "summary": "Enqueue non-business demonstration work atomically",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "required": false,
            "name": "Idempotency-Key",
            "in": "header"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {},
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Existing request returned for repeated key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FoundationWorkResponse"
                }
              }
            }
          },
          "202": {
            "description": "First request created and work queued",
            "headers": {
              "X-Correlation-Id": {
                "$ref": "#/components/headers/XCorrelationId"
              },
              "Location": {
                "description": "Same-origin status resource",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FoundationWorkResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "Not found / disabled",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "Unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/foundation/work/{requestId}": {
      "get": {
        "tags": [
          "Foundation"
        ],
        "operationId": "getFoundationWork",
        "summary": "Read demonstration work status",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "requestId",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Current safe work projection",
            "headers": {
              "X-Correlation-Id": {
                "$ref": "#/components/headers/XCorrelationId"
              },
              "Cache-Control": {
                "$ref": "#/components/headers/NoStore"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FoundationWorkResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    }
  }
}