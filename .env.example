# Agentix Foundation - Local development example
# Copy to .env.local and set real values. Never commit .env.local

# Required: PostgreSQL connection string
DATABASE_URL=postgresql://test:test@localhost:5432/agentix_test

# Required in production: exact origin of the web app
APP_ORIGIN=http://localhost:3000

# Optional: comma-separated exact CORS origins for extra cross-origin callers.
# Same-origin browser requests (matching APP_ORIGIN or the request Host) are always
# allowed, so leave this empty for local development. Only add origins here if the
# UI is served from a different origin than the API (e.g. split hosting, previews).
CORS_ORIGINS=

# Optional: log level (debug, info, warn, error)
LOG_LEVEL=info

# Optional: OTLP endpoints (disabled if not set)
OTEL_TRACES_EXPORTER_URL=
OTEL_METRICS_EXPORTER_URL=

# Worker settings (safe defaults)
WORKER_POLL_INTERVAL_MS=1000
WORKER_BATCH_SIZE=10
WORKER_LEASE_SECONDS=30
WORKER_MAX_ATTEMPTS=3
WORKER_SHUTDOWN_SECONDS=30

# Foundation demo route (enabled in local/test, disabled in production by default)
FOUNDATION_DEMO_ENABLED=true

# Identity - Auth.js secret (required in production, server-only)
# Generate with: openssl rand -base64 32
AUTH_SECRET=your-auth-secret-min-32-chars

# Identity - Message delivery encryption key (required in production, server-only)
# Must be 32 bytes base64 or hex; used for AES-256-GCM encryption of token-bearing outbox payloads
# Generate with: openssl rand -base64 32
MESSAGE_DELIVERY_KEY=your-32-byte-base64-encryption-key

# Identity - Message delivery key version (for key rotation)
MESSAGE_DELIVERY_KEY_VERSION=1

# Optional: Auth session expiry in seconds (default 30 days)
AUTH_SESSION_MAX_AGE=2592000
