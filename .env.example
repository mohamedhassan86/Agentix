# Agentix Foundation - Local development example
# Copy to .env.local and set real values. Never commit .env.local

# Required: PostgreSQL connection string.
# On Vercel you do NOT need this when the Postgres/Neon integration is connected:
# the app falls back to POSTGRES_URL / POSTGRES_PRISMA_URL automatically
# (see src/infrastructure/config/database-url.ts).
DATABASE_URL=postgresql://test:test@localhost:5432/agentix_test

# Optional (set by the Vercel Postgres / Neon integration, read by the app):
# POSTGRES_URL=                     pooled endpoint -> used for runtime queries
# POSTGRES_PRISMA_URL=              pooled endpoint tuned for Prisma
# POSTGRES_URL_NON_POOLING=         direct endpoint -> REQUIRED for prisma migrate
# DATABASE_URL_UNPOOLED=            same as above for newer Neon-provisioned projects

# Pool tuning (defaults are serverless-aware)
# DB_POOL_MAX=3                     1-3 when the URL points at a PgBouncer pooler
# DB_CONNECTION_TIMEOUT_MS=10000    hosted Postgres cold starts can exceed 2s
# DB_IDLE_TIMEOUT_MS=10000          release quickly so serverless instances don't hold slots
# DB_READINESS_TIMEOUT_MS=2000      /health/ready budget only
# DB_STATEMENT_TIMEOUT_MS=          optional server-side statement_timeout
# DB_ALLOW_INSECURE_TLS=true        skip TLS entirely (never in production)
# DB_SSL_NO_VERIFY=true             TLS without cert verification, for a pooler whose cert
#                                   does not match its hostname (never in production)

# Required in production: exact origin of the web app
APP_ORIGIN=http://localhost:3000

# Optional: comma-separated exact CORS origins (same-origin by default)
CORS_ORIGINS=

# Optional: log level (debug, info, warn, error)
LOG_LEVEL=info

# Optional: OTLP endpoints (disabled if not set)
OTEL_TRACES_EXPORTER_URL=
OTEL_METRICS_EXPORTER_URL=

# Worker settings (safe defaults)
# NOTE: the worker is a long-running poller and cannot run on Vercel serverless.
# Host it on Railway/Fly/a container, or trigger it from Vercel Cron.
WORKER_POLL_INTERVAL_MS=1000
WORKER_BATCH_SIZE=10
WORKER_LEASE_SECONDS=30
WORKER_MAX_ATTEMPTS=3
WORKER_SHUTDOWN_SECONDS=30

# Local escape hatch: keep the offline Prisma stub in non-production runs
ALLOW_PRISMA_STUB=false

# Foundation demo route (enabled in local/test, disabled in production by default)
FOUNDATION_DEMO_ENABLED=true
