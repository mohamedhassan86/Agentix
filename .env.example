# Agentix Foundation - Local development example
# Copy to .env.local and set real values. Never commit .env.local

# Required: PostgreSQL connection string.
# Runtime (serverless/Vercel): use the POOLED connection - Supabase transaction pooler, port 6543.
DATABASE_URL=postgresql://test:test@localhost:5432/agentix_test

# Migrations only: the DIRECT/session connection (port 5432). Required for Supabase because
# `prisma migrate deploy` cannot run through the transaction pooler (port 6543).
# Supabase direct connections are IPv6-only, so on IPv4-only networks use the session pooler URL
# (same *.pooler.supabase.com host, port 5432) instead.
DIRECT_URL=postgresql://test:test@localhost:5432/agentix_test

# Alternative names, accepted without renaming anything:
# - the Supabase <-> Vercel integration injects POSTGRES_PRISMA_URL / POSTGRES_URL (pooled) and
#   POSTGRES_URL_NON_POOLING (direct); the app and scripts accept those instead of DATABASE_URL.

# Required in production: exact origin of the web app.
# On Vercel this is optional: it falls back to VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL.
APP_ORIGIN=http://localhost:3000

# Optional: comma-separated exact CORS origins (same-origin by default)
CORS_ORIGINS=

# Optional: log level (debug, info, warn, error)
LOG_LEVEL=info

# Optional: OTLP endpoints (disabled if not set)
OTEL_TRACES_EXPORTER_URL=
OTEL_METRICS_EXPORTER_URL=

# Optional: per-instance Postgres pool size (default 10, lower it on serverless)
PG_POOL_MAX=

# Optional: TLS for the runtime pool. Defaults to "require" for remote hosts and "disable" for
# localhost - node-postgres does not default to TLS, and hosted Postgres closes a plaintext
# connection with no error code. Values: disable | require | verify-ca | verify-full
PG_SSL_MODE=

# Optional: CA bundle used by verify-ca / verify-full (Supabase: Settings -> Database -> SSL)
PG_SSL_CA=

# Optional: TCP/connection timeout in ms (default 2000, bounded by the 2s readiness probe)
PG_CONNECT_TIMEOUT_MS=

# Worker settings (safe defaults)
WORKER_POLL_INTERVAL_MS=1000
WORKER_BATCH_SIZE=10
WORKER_LEASE_SECONDS=30
WORKER_MAX_ATTEMPTS=3
WORKER_SHUTDOWN_SECONDS=30

# Foundation demo route (enabled in local/test, disabled in production by default)
FOUNDATION_DEMO_ENABLED=true

# Deployment build step (Vercel: npm run build:vercel)
# SKIP_DB_MIGRATE=true        skip migrations entirely (e.g. preview build without a database)
# DB_MIGRATE_ON_PREVIEW=true  also migrate from Vercel preview/development builds (off by default)
# DB_MIGRATE_OPTIONAL=true    never fail the build when migrations fail; warn instead
# PRISMA_GENERATE_REQUIRED=true  fail the build when the Prisma client cannot be generated
# AGENTIX_REQUIRE_MIGRATION_MARKER=true  fail a Vercel production build when migrations did not run
# MIGRATE_TIMEOUT_MS=120000   hard timeout for the migration run
